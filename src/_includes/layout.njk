<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <meta name="description" content="{{ description }}">
    <title>{{ title }} — Smaznov.</title>
    <script>
      document.documentElement.classList.add('has-js');
      document.addEventListener('load', (event) => {
        const image = event.target;
        if (!(image instanceof HTMLImageElement)) return;
        const placeholder = image.closest('.image-placeholder');
        if (!placeholder) return;

        const reveal = () => {
          if (!image.naturalWidth) return;
          image.classList.add('image-reveal--ready');
          placeholder.classList.add('image-placeholder--ready');
        };

        if (typeof image.decode === 'function') image.decode().then(reveal, reveal);
        else reveal();
      }, true);
    </script>
    <link rel="preload" href="/assets/fonts/dm-sans-variable.ttf" as="font" type="font/ttf" crossorigin>
    <link rel="stylesheet" href="/assets/css/tokens.css">
    <link rel="stylesheet" href="/assets/css/styles.css">
  </head>
  <body>
    <a class="skip-link" href="#main-content">Skip to content</a>
    <div class="site-layout">
      <header class="site-layout__sidebar site-header">
        <a class="site-brand" href="/" aria-label="Smaznov. — Main"{% if pageKey == 'main' %} aria-current="page"{% endif %}>
          <span class="site-brand__portrait portrait">
            <img class="portrait__image" src="/assets/images/portrait.png" width="71" height="71" alt="">
          </span>
          <span class="site-brand__name">Smaznov.</span>
        </a>
        <div class="site-header__intro" id="page-intro" data-page-transition>
          <h1 class="site-header__title" id="page-title">{% if pageKey == 'main' %}Digital<br>Product Designer{% else %}{{ title }}{% endif %}</h1>
          {% if pageKey == 'main' %}<p class="site-header__tagline">I turn ideas into&nbsp;thoughtful digital&nbsp;experiences.</p>{% endif %}
        </div>
        {% include "navigation.njk" %}
      </header>
      <main class="site-layout__content" id="main-content" tabindex="-1" aria-labelledby="page-title" data-page-transition data-page-key="{{ pageKey }}" data-page-label="{% if pageKey == 'main' %}Smaznov.{% else %}{{ title }}{% endif %}">
        <div class="site-layout__content-inner">
          {{ content | safe }}
        </div>
      </main>
    </div>
    <div class="scroll-menu" data-scroll-menu hidden>
      <button class="scroll-menu__button" type="button" aria-label="Scroll to top" data-scroll-menu-button>
        <span class="scroll-menu__portrait portrait">
          <img class="portrait__image" src="/assets/images/portrait.png" alt="" width="28" height="28">
        </span>
        <span class="scroll-menu__label" data-scroll-menu-label>{% if pageKey == 'main' %}Smaznov.{% else %}{{ title }}{% endif %}</span>
      </button>
    </div>
    <script src="/assets/js/site.bundle.js" defer></script>
  </body>
</html>
